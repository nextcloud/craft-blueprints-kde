 # that can be overridden by a different file depending on the inclusion order of the
 # cmake files, and thus pointing to a different dir.
 set_property(GLOBAL PROPERTY __qt_sbom_generation_helpers_base_dir "${CMAKE_CURRENT_LIST_DIR}")
+
+# Generate install-time path handling, shared by document output and checksum lookup.
+# CMake stages drive-qualified Windows prefixes without the drive letter. DESTDIR must
+# be evaluated at install time, and direct installs must retain their drive letter.
+function(_qt_internal_sbom_get_staged_path_code out_var path_var install_path)
+    set(code "
+        set(${path_var} \"${install_path}\")
+        if(WIN32)
+            string(REPLACE \"\\\\\" \"/\" ${path_var} \"\${${path_var}}\")
+        endif()
+        if(NOT \"\$ENV{DESTDIR}\" STREQUAL \"\")
+            if(WIN32)
+                string(REGEX REPLACE \"^[A-Za-z]:\" \"\" ${path_var} \"\${${path_var}}\")
+            endif()
+            set(${path_var} \"\$ENV{DESTDIR}\${${path_var}}\")
+            if(WIN32)
+                string(REPLACE \"\\\\\" \"/\" ${path_var} \"\${${path_var}}\")
+            endif()
+        endif()
+")
+    set(${out_var} "${code}" PARENT_SCOPE)
+endfunction()
 
